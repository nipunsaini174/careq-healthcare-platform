generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = "file:./dev.db"
}

model admins {
  admin_id    Int    @id @default(autoincrement())
  user_id     Int    @unique
  hospital_id Int    @unique
  admin_level String    
  permissions String
  hospitals   hospitals @relation(fields: [hospital_id], references: [hospital_id])
  users       users     @relation(fields: [user_id], references: [user_id])
}

model appointments {
  appointment_id          Int                   @id @default(autoincrement())
  patient_id              Int
  doctor_id               Int
  hospital_id             Int
  appointment_date        DateTime
  appointment_type        String                   
  appointment_status      String                   
  created_at              DateTime                 @default(now())
  doctors                 doctors                  @relation(fields: [doctor_id], references: [doctor_id])
  hospitals               hospitals                @relation(fields: [hospital_id], references: [hospital_id])
  patients                patients                 @relation(fields: [patient_id], references: [patient_id])
  follow_up_consultations follow_up_consultations?
  queue_tokens            queue_tokens?
}

model billing_invoices {
  invoice_id      Int        @id @default(autoincrement())
  patient_id      Int
  hospital_id     Int
  consultation_id Int        @unique
  amount          Float       
  payment_status  String        
  invoice_date    DateTime
  consultations   consultations @relation(fields: [consultation_id], references: [consultation_id])
  hospitals       hospitals     @relation(fields: [hospital_id], references: [hospital_id])
  patients        patients      @relation(fields: [patient_id], references: [patient_id])
}

model consultations {
  consultation_id         Int                    @id @default(autoincrement())
  patient_id              Int
  doctor_id               Int
  token_id                Int                    @unique
  reason_for_visit        String
  clinical_alerts         String
  stage                   String                    
  consultation_notes      String
  start_time              DateTime
  end_time                DateTime
  duration                Int
  consultation_status     String                    
  billing_invoices        billing_invoices?
  doctors                 doctors                   @relation(fields: [doctor_id], references: [doctor_id])
  patients                patients                  @relation(fields: [patient_id], references: [patient_id])
  queue_tokens            queue_tokens              @relation(fields: [token_id], references: [token_id])
  follow_up_consultations follow_up_consultations[]
  lab_reports             lab_reports[]
}

model departments {
  department_id   Int    @id @default(autoincrement())
  hospital_id     Int
  department_name String    
  location        String    
  daily_capacity  Int
  created_at      DateTime  @default(now())
  hospitals       hospitals @relation(fields: [hospital_id], references: [hospital_id])
  doctors         doctors[]
}

model doctors {
  doctor_id               Int                    @id @default(autoincrement())
  user_id                 Int                    @unique
  hospital_id             Int
  department_id           Int
  specialization          String                    
  qualification           String                    
  experience_years        Int
  rating                  Float                   
  availability_status     String                    
  phone                   String?                   
  opd                     String?                   
  schedule                String?                   
  bio                     String?
  focus                   String?
  credentials             String?
  room                    String?                   
  awards                  String?
  appointments            appointments[]
  consultations           consultations[]
  departments             departments               @relation(fields: [department_id], references: [department_id])
  hospitals               hospitals                 @relation(fields: [hospital_id], references: [hospital_id])
  users                   users                     @relation(fields: [user_id], references: [user_id])
  follow_up_consultations follow_up_consultations[]
  lab_reports             lab_reports[]
  patients                patients[]
  queue_tokens            queue_tokens[]
  walk_in_patients        walk_in_patients[]
}

model follow_up_consultations {
  followup_id            Int        @id @default(autoincrement())
  parent_consultation_id Int
  patient_id             Int
  doctor_id              Int
  hospital_id            Int
  appointment_id         Int?       @unique
  token_id               Int?       @unique
  revisit_reason         String
  test_results_attached  Boolean
  planned_duration_mins  Int
  followup_notes         String
  followup_status        String        
  appointments           appointments? @relation(fields: [appointment_id], references: [appointment_id])
  doctors                doctors       @relation(fields: [doctor_id], references: [doctor_id])
  hospitals              hospitals     @relation(fields: [hospital_id], references: [hospital_id])
  consultations          consultations @relation(fields: [parent_consultation_id], references: [consultation_id])
  patients               patients      @relation(fields: [patient_id], references: [patient_id])
  queue_tokens           queue_tokens? @relation(fields: [token_id], references: [token_id])
}

model hospitals {
  hospital_id             Int                    @id @default(autoincrement())
  hospital_name           String                    
  registration_no         String                    
  branch_name             String                    
  address                 String
  phone                   String                    
  email                   String                    
  working_hours           String                    
  created_at              DateTime                  @default(now())
  admins                  admins?
  appointments            appointments[]
  billing_invoices        billing_invoices[]
  departments             departments[]
  doctors                 doctors[]
  follow_up_consultations follow_up_consultations[]
  lab_reports             lab_reports[]
  notifications           notifications[]
  patients                patients[]
  queue_tokens            queue_tokens[]
  receptionists           receptionists[]
  users                   users[]
  walk_in_patients        walk_in_patients[]
  treatment_journeys      treatment_journeys[]
  risk_assessments        risk_assessments[]
  interventions           interventions[]
  retention_followups     retention_followups[]
}

model lab_reports {
  report_id       Int         @id @default(autoincrement())
  patient_id      Int
  doctor_id       Int
  hospital_id     Int
  consultation_id Int?
  report_type     String         
  report_name     String         
  report_file_url String
  uploaded_by     String         
  report_status   String         
  uploaded_at     DateTime
  reviewed_at     DateTime?
  created_at      DateTime       @default(now())
  consultations   consultations? @relation(fields: [consultation_id], references: [consultation_id])
  doctors         doctors        @relation(fields: [doctor_id], references: [doctor_id])
  hospitals       hospitals      @relation(fields: [hospital_id], references: [hospital_id])
  patients        patients       @relation(fields: [patient_id], references: [patient_id])
}

model notifications {
  notification_id Int    @id @default(autoincrement())
  hospital_id     Int
  user_id         Int
  category        String    
  title           String    
  message         String
  severity        String    
  is_read         Boolean   @default(false)
  created_at      DateTime  @default(now())
  hospitals       hospitals @relation(fields: [hospital_id], references: [hospital_id])
  users           users     @relation(fields: [user_id], references: [user_id])
}

model patients {
  patient_id              Int                    @id @default(autoincrement())
  hospital_id             Int
  primary_doctor_id       Int?
  uhid                    String                    
  full_name               String                    
  age                     Int
  gender                  String                    
  blood_group             String                    
  billing_status          String                    
  patient_status          String                    
  abha_id                 String?                   
  dob                     String?                   
  email                   String?                   
  phone                   String?                   
  user_id                 Int?                   @unique
  appointments            appointments[]
  billing_invoices        billing_invoices[]
  consultations           consultations[]
  follow_up_consultations follow_up_consultations[]
  lab_reports             lab_reports[]
  patient_profiles        patient_profiles[]
  hospitals               hospitals                 @relation(fields: [hospital_id], references: [hospital_id])
  doctors                 doctors?                  @relation(fields: [primary_doctor_id], references: [doctor_id])
  users                   users?                    @relation(fields: [user_id], references: [user_id])
  queue_tokens            queue_tokens[]
  treatment_journeys      treatment_journeys[]
  risk_assessments        risk_assessments[]
  interventions           interventions[]
  retention_followups     retention_followups[]
}

/// Family members / dependents that an account owner (the `patients` row linked
/// to a login user) can book appointments and store reports for. This powers
/// the patient-app "people" filter (filter appointments/reports by person).
///
/// NOTE: forward-looking structure. Requires a migration to be created/applied
/// (`prisma migrate dev`). The patient frontend currently manages this data in
/// localStorage (see `patient-frontend/lib/people.ts`) and can be switched to
/// these tables without UI changes. When wiring the backend, also add a nullable
/// `profile_id` FK on `appointments` and `lab_reports` referencing this model.
model patient_profiles {
  profile_id       Int   @id @default(autoincrement())
  /// the account owner this dependent belongs to
  owner_patient_id Int
  hospital_id      Int
  full_name        String   
  /// "Self", "Father", "Mother", or any user-defined custom relation
  relationship     String   
  age              Int?
  gender           String?  
  is_self          Boolean  @default(false)
  created_at       DateTime @default(now())
  patients         patients @relation(fields: [owner_patient_id], references: [patient_id])

  @@index([owner_patient_id])
}

model queue_tokens {
  token_id                Int                   @id @default(autoincrement())
  patient_id              Int
  doctor_id               Int
  hospital_id             Int
  appointment_id          Int?                  @unique
  walkin_id               Int?
  token_code              String                   
  token_type              String                   
  queue_position          Int
  priority_score          Int
  token_status            String                   
  check_in_time           DateTime
  estimated_wait_time     Int
  consultations           consultations?
  follow_up_consultations follow_up_consultations?
  appointments            appointments?            @relation(fields: [appointment_id], references: [appointment_id])
  doctors                 doctors                  @relation(fields: [doctor_id], references: [doctor_id])
  hospitals               hospitals                @relation(fields: [hospital_id], references: [hospital_id])
  patients                patients                 @relation(fields: [patient_id], references: [patient_id])
  walk_in_patients        walk_in_patients?        @relation(fields: [walkin_id], references: [walkin_id])
}

model receptionists {
  receptionist_id  Int             @id @default(autoincrement())
  user_id          Int             @unique
  hospital_id      Int
  shift_start      DateTime           
  shift_end        DateTime           
  status           String             
  hospitals        hospitals          @relation(fields: [hospital_id], references: [hospital_id])
  users            users              @relation(fields: [user_id], references: [user_id])
  walk_in_patients walk_in_patients[]
}

model users {
  user_id       Int          @id @default(autoincrement())
  hospital_id   Int
  full_name     String          
  email         String          
  password_hash String
  role          String          
  status        String          
  last_login    DateTime?
  phone         String?         
  admins        admins?
  doctors       doctors?
  notifications notifications[]
  patients      patients?
  receptionists receptionists?
  hospitals     hospitals       @relation(fields: [hospital_id], references: [hospital_id])
  interventions interventions[]
}

model walk_in_patients {
  walkin_id         Int         @id @default(autoincrement())
  hospital_id       Int
  receptionist_id   Int
  doctor_id         Int
  full_name         String         
  age               Int
  is_senior_citizen Boolean
  reason_for_visit  String
  arrival_time      DateTime
  placement_type    String         
  priority_score    Int
  walkin_status     String         
  queue_tokens      queue_tokens[]
  doctors           doctors        @relation(fields: [doctor_id], references: [doctor_id])
  hospitals         hospitals      @relation(fields: [hospital_id], references: [hospital_id])
  receptionists     receptionists  @relation(fields: [receptionist_id], references: [receptionist_id])
}

model diseases {
  disease_id          Int                @id @default(autoincrement())
  disease_name        String                
  disease_type        String                
  treatment_journeys  treatment_journeys[]
}

model treatment_journeys {
  journey_id             Int                @id @default(autoincrement())
  patient_id             Int
  hospital_id            Int
  disease_id             Int
  status                 String                
  start_date             DateTime
  last_visit_date        DateTime?
  next_followup_date     DateTime?
  missed_appointments    Int                   @default(0)
  adherence_score        Int                   @default(100)
  consecutive_missed     Int                   @default(0)
  total_appointments     Int                   @default(0)
  completed_appointments Int                   @default(0)
  average_visit_gap_days Int?
  
  patients               patients              @relation(fields: [patient_id], references: [patient_id])
  hospitals              hospitals             @relation(fields: [hospital_id], references: [hospital_id])
  diseases               diseases              @relation(fields: [disease_id], references: [disease_id])
  
  risk_assessments       risk_assessments[]
  interventions          interventions[]
  retention_followups    retention_followups[]
}

model risk_assessments {
  assessment_id      Int         @id @default(autoincrement())
  journey_id         Int
  patient_id         Int
  hospital_id        Int
  risk_score         Int
  risk_level         String         
  model_version      String         
  recommended_action String         
  prediction_date    DateTime       @default(now())
  
  treatment_journeys treatment_journeys @relation(fields: [journey_id], references: [journey_id])
  patients           patients       @relation(fields: [patient_id], references: [patient_id])
  hospitals          hospitals      @relation(fields: [hospital_id], references: [hospital_id])
  risk_factors       risk_factors[]
  interventions      interventions[]
}

model risk_factors {
  factor_id     Int           @id @default(autoincrement())
  assessment_id Int
  factor_name   String           
  factor_value  String           
  contribution  Int
  
  risk_assessments risk_assessments @relation(fields: [assessment_id], references: [assessment_id])
}

model interventions {
  intervention_id   Int           @id @default(autoincrement())
  patient_id        Int
  journey_id        Int
  assessment_id     Int
  hospital_id       Int
  assigned_to       Int?
  intervention_type String           
  priority          String           
  status            String           
  recommended_by_ai Boolean
  outcome           String?          
  outcome_notes     String?
  created_at        DateTime         @default(now())
  completed_at      DateTime?
  
  patients           patients           @relation(fields: [patient_id], references: [patient_id])
  treatment_journeys treatment_journeys @relation(fields: [journey_id], references: [journey_id])
  risk_assessments   risk_assessments   @relation(fields: [assessment_id], references: [assessment_id])
  hospitals          hospitals          @relation(fields: [hospital_id], references: [hospital_id])
  assigned_user      users?             @relation(fields: [assigned_to], references: [user_id])
}

model retention_followups {
  followup_id    Int             @id @default(autoincrement())
  patient_id     Int
  journey_id     Int
  hospital_id    Int
  scheduled_date DateTime
  completed_date DateTime?
  status         String             
  notes          String?
  
  patients           patients           @relation(fields: [patient_id], references: [patient_id])
  treatment_journeys treatment_journeys @relation(fields: [journey_id], references: [journey_id])
  hospitals          hospitals          @relation(fields: [hospital_id], references: [hospital_id])
}
