# ==========================================
# SuvidhaQ / CareQ Environment Variables
# ==========================================

# --- Backend Config ---
PORT=5000
DATABASE_URL="postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"
JWT_SECRET="your-strong-jwt-secret"

# --- Supabase Config ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SECRET_KEY="your-supabase-secret-key"

# --- CORS Config (Backend) ---
# Comma-separated list of deployed frontend URLs:
CORS_ALLOWED_ORIGINS="https://qflow-hospital-frontend.onrender.com,https://qflow-patient-frontend.onrender.com"

# --- Frontends (Client-side) ---
NEXT_PUBLIC_API_URL="https://qflow-backend.onrender.com/api"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-publishable-key"
